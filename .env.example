# Stage 7 AI server configuration.
# Create the key in Google AI Studio / Gemini API and keep it server-side only.
GEMINI_API_KEY=

# Set this to a Gemini model available to your project.
# Kept explicit instead of hard-coding a model so deployments can upgrade safely.
GEMINI_MODEL=

# Optional override for tests/proxies. Normal deployments should use the default.
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
