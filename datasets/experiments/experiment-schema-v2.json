{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aria-lab.local/schemas/experiment-v2.json",
  "title": "Aria Lab Experiment Package v2",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "domain", "scene", "guide", "measurements", "assessment"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string" },
    "titleFa": { "type": "string" },
    "domain": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "summary": { "type": "string" },
    "summaryFa": { "type": "string" },
    "learningObjectives": { "type": "array", "items": { "type": "string" } },
    "prerequisites": { "type": "array" },
    "scene": { "type": "object", "required": ["schemaVersion", "parts", "connections"] },
    "guide": {
      "type": "object",
      "required": ["steps"],
      "properties": {
        "mode": { "enum": ["guided", "free", "assessment"] },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "titleFa": { "type": "string" },
              "instructionFa": { "type": "string" },
              "whyFa": { "type": "string" },
              "checks": { "type": "array" },
              "hints": { "type": "array" }
            }
          }
        }
      }
    },
    "measurements": { "type": "array" },
    "expectedResults": { "type": "array" },
    "assessment": {
      "type": "object",
      "required": ["passThreshold", "rules"],
      "properties": {
        "passThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "rules": { "type": "array" }
      }
    },
    "assistant": { "type": "object" },
    "metadata": { "type": "object" }
  }
}
